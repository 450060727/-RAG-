# 小马项目环境变量示例
# 复制本文件为 .env 并根据实际环境填写，切勿将真实密码提交到仓库

# ===================== MySQL =====================
MYSQL_DATABASE=xiaoma
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag@123456

# 后端连接用（和 docker-compose 中的 MySQL 服务对齐）
DB_URL=jdbc:mysql://mysql:3306/xiaoma?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=rag_user
DB_PASSWORD=rag@123456

# ===================== Redis =====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=666666
REDIS_DB=0

# ===================== SMTP（前台邮件验证码） =====================
MAIL_HOST=smtp.qiye.aliyun.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# ===================== Milvus（知识库向量库） =====================
KB_MILVUS_HOST=milvus
KB_MILVUS_PORT=19530
KB_MILVUS_USERNAME=root
KB_MILVUS_PASSWORD=

# ===================== Embedding / Chat / Rerank 云端厂商 API Key =====================
KB_EMBEDDING_API_KEY=
KB_CHAT_API_KEY=
KB_RERANK_API_KEY=

# ===================== JWT =====================
JWT_SECRET=abcdefghijklmnopqrstuvwxyz123456
JWT_EXPIRE_MINUTES=1440

# ===================== 默认凭证（首次启动后务必修改） =====================
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
USER_DEFAULT_PASSWORD=123456
