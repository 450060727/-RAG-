<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.xiaoma</groupId>
  <artifactId>xiaoma-parent</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <name>xiaoma-parent</name>
  <description>小马项目聚合父工程：前台服务 + 后台服务 + 共享库</description>

  <properties>
    <!-- Java 版本：与本地 JDK 保持一致 -->
    <java.version>23</java.version>
    <!-- Log4j2 版本：统一由父工程锁定，避免子模块传递冲突 -->
    <log4j2.version>2.24.3</log4j2.version>
  </properties>

  <modules>
    <module>shared-lib</module>
    <module>front-service/backend</module>
    <module>admin-service/backend</module>
  </modules>
</project>
